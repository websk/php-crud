{
  "name": "websk_php_crud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@popperjs/core": "2.11.8",
    "ace-builds": "1.45.2",
    "blueimp-file-upload": "10.32.0",
    "bootstrap": "5.3.8",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.2",
    "jquery-validation": "1.22.1",
    "medium-editor": "5.23.3",
    "tokenize2": "https://github.com/dragonofmercy/Tokenize2/archive/refs/tags/1.3.5.tar.gz"
  },
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "lint:js": "eslint eslint.config.js playwright.config.js playwright.docker.config.js scripts tests/browser/*.js tests/browser-docker/*.js",
    "check:assets": "node scripts/build-assets.mjs --check",
    "test:browser": "playwright test",
    "test:browser:docker": "playwright test --config=playwright.docker.config.js",
    "check": "npm run lint:js && npm run check:assets && npm run test:browser",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "audit:high": "npm audit --audit-level=high"
  },
  "author": "support@websk.ru",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0"
  }
}
